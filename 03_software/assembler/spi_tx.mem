8000  //  0: pull                    ; get the byte to send from the TX FIFO
1001  //  1: out   pins[0], 1        ; put bit 0 on MISO
B026  //  2: set   x, 6              ; 7 more bits to go
C020  //  3: wait  0, pins[0]        ; wait for CS low
C1A0  //  4: wait  1, pins[1]        ; SCK rising: the Arduino reads MISO
C120  //  5: wait  0, pins[1]        ; SCK falling: our turn
1001  //  6: out   pins[0], 1        ; put the next bit on MISO
A044  //  7: jmp   x--, bit          ; repeat for bits 1..7
C0A0  //  8: wait  1, pins[0]        ; wait for CS high: transaction over
A000  //  9: jmp   frame
